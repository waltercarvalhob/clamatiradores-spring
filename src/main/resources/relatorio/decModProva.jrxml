	<parameter name="nome" class="java.lang.String"/>
	<parameter name="id_decmodprova" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[select id_decmodprova,socio.id_socio,socio.nome as nome ,socio.cpf,socio.numcr,socio.numclam,REGEXP_REPLACE(md5(socio.cpf),'[[:alpha:]]','','g')as code_identificacao,dia,mes,ano,dataatual,dataemissao,datavalidade from declaracaomodprova
inner join socio on socio.id_socio = declaracaomodprova.id_socio
where nome  like $P{nome} and id_decmodprova = $P{id_decmodprova}]]>
	</queryString>
