	<queryString language="SQL">
		<![CDATA[select ano,mes,cr,nome,dataadm,nivel,municao,treinos,municipal,estadual,federal,
(select count(*) from habitualidade where mes like $P{mes} and ano like $P{ano}) as qtd
from habitualidade  where mes like $P{mes} and ano like $P{ano}  order by nome


