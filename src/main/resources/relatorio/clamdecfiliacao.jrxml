	<parameter name="nome" class="java.lang.String"/>
	<parameter name="id_dec" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[select id_dec,socio.id_socio,socio.nome as nome ,socio.cpf,socio.numclam as numclam,socio.endereco as endereco ,socio.numcr as numcr,REGEXP_REPLACE(md5(socio.cpf),'[[:alpha:]]','','g')as code_identificacao,dia,mes,ano,datainsc,dataemissao,datavalidade from declaracao
inner join socio on socio.id_socio = declaracao.id_socio
where nome  like $P{nome} and id_dec = $P{id_dec}]]>
	</queryString>
